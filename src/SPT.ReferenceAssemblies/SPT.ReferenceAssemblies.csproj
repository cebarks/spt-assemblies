<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PackageId>SPT.ReferenceAssemblies</PackageId>
    <Version>1.0.1-spt4.1.3</Version>
    <Authors>cebarks</Authors>
    <Description>Reference assemblies for building SPT mods without a game install</Description>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/cebarks/spt-assemblies</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cebarks/spt-assemblies</RepositoryUrl>
    <!-- ponytail: no compilation — this project only packages pre-built ref DLLs -->
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128/NU5131: this package has no build output at all by design (NoBuild +
         IncludeBuildOutput=false); the ref/ payload is packed as content below, so NuGet's
         "nuspec references not found in build output" checks are false positives here. -->
    <NoWarn>$(NoWarn);NU5128;NU5131</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- Belt and braces: AssemblyDiscovery skips these at generation time, but a ref folder
         produced by an older generator would otherwise leak them back into the package. -->
    <None Include="ref/net472/**/*.dll" Exclude="ref/net472/0Harmony20.dll;ref/net472/where-allocations.dll" Pack="true" PackagePath="ref/net472/" />
  </ItemGroup>

</Project>
